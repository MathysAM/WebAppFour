@page "/counter"
@inject IJSRuntime JS
@using System.Globalization
@using Microsoft.JSInterop
@implements IAsyncDisposable

<PageTitle>Counter</PageTitle>

<div class="mb-3">
    <label class="form-label">Consigne température</label>
    <input class="form-control"
           placeholder="ex: 23.50"
           @bind="consigneRaw"
           @bind:event="oninput"
           @onblur="FormatConsigne" />
    @if (!string.IsNullOrEmpty(consigneError))
    {
        <div class="text-danger small mt-1">@consigneError</div>
    }
</div>

<button class="btn btn-primary me-3" @onclick="PublishConsigne">
    📡 Publier consigne
</button>

<button class="btn btn-success me-2" @onclick="PublishStart">▶️ Start</button>
<button class="btn btn-danger" @onclick="PublishStop">⏹️ Stop  </button>
<div class="mb-2"><strong>Régulation :</strong> @reguleEtatText</div>
<div class="mb-3"><strong>Four :</strong> @fourEtatText</div>
<div class="mb-3"><strong>Température :</strong> @temperatureText</div>


@code {
    private string temperatureText = "—";
    private string reguleEtatText = "—";
    private string fourEtatText = "—";
    private string consigneRaw = "";
    private string? consigneError;
    // Référence .NET pour les callbacks JS -> .NET
    private DotNetObjectReference<Counter>? _selfRef; // remplace "Counter" par le nom réel du composant
    private bool _consigneSubscribed;                 // simple garde-fou

    protected override async Task OnInitializedAsync()
    {
        try
        {
            if (!_consigneSubscribed)
            {
                _selfRef = DotNetObjectReference.Create(this);
                await JS.InvokeVoidAsync("subscribeToMqtt", "/Sup/ConsigneTemperture", _selfRef, nameof(SetConsigneFromMqtt), 0 ); // 👈 ajout : index obligatoire pour ton JS
                _consigneSubscribed = true;
                await JS.InvokeVoidAsync("subscribeToMqtt", "/automate/ReguleEtat", _selfRef, nameof(SetReguleEtat), 0);
                await JS.InvokeVoidAsync("subscribeToMqtt", "/automate/EtatFour", _selfRef, nameof(SetFourEtat), 0);
                await JS.InvokeVoidAsync("subscribeToMqtt", "/automate/temperature", _selfRef, nameof(SetTemperature), 0);

    
  
    
   

                
            }
        }
        catch (JSException ex)
        {
            Console.WriteLine($"[JS Error] {ex.Message}");
        }
    }
    [JSInvokable]
    public async Task SetTemperature(string payload, int index)
    {
        var s = (payload ?? "").Trim();
        if (double.TryParse(s, NumberStyles.Float, CultureInfo.InvariantCulture, out var value) ||
            double.TryParse(s, NumberStyles.Float, CultureInfo.GetCultureInfo("fr-FR"), out value))
        {
            temperatureText = $"{value:0.00} °C";
        }
        else
        {
            temperatureText = "Valeur invalide";
        }
        await InvokeAsync(StateHasChanged);
    }
    [JSInvokable]
    public async Task SetReguleEtat(string payload, int index)
    {
        var b = ParseMqttBool(payload);
        reguleEtatText = b ? "Régulation en cours" : "Régulation arrêtée";
        await InvokeAsync(StateHasChanged);
    }

    [JSInvokable]
    public async Task SetFourEtat(string payload, int index)
    {
        var b = ParseMqttBool(payload);
        fourEtatText = b ? "Four en marche" : "Four arrêté";
        await InvokeAsync(StateHasChanged);
    }

    // true/false ou 1/0 (insensible à la casse/espaces)
    private static bool ParseMqttBool(string? s)
    {
        var v = (s ?? "").Trim().ToLowerInvariant();
        return v == "true" || v == "1";
    }

    [JSInvokable]
    
    public async Task SetConsigneFromMqtt(string payload, int index) // ← renommé
    {
        var s = (payload ?? "").Trim();
        if (TryParseTwoDecimals(s, out var formatted, out _)) // ← maintenant _ est un discard valide
        {
            consigneRaw = formatted;
            await InvokeAsync(StateHasChanged);
        }
    }


    private async Task PublishStart()
    {
        await JS.InvokeVoidAsync("publishMomentary", "/Sup/Start");
    }

    private async Task PublishStop()
    {
        await JS.InvokeVoidAsync("publishMomentary", "/Sup/Stop");
    }

    private async Task PublishConsigne()
    {
        if (!TryParseTwoDecimals(consigneRaw, out var formatted, out var err))
        {
            consigneError = err;
            return;
        }

        consigneError = null;
        await JS.InvokeVoidAsync("publishMqttValue", "/Sup/ConsigneTemperture", formatted);
        consigneRaw = formatted;
    }

    private Task FormatConsigne(FocusEventArgs _)
    {
        if (TryParseTwoDecimals(consigneRaw, out var formatted, out var err))
        {
            consigneRaw = formatted;
            consigneError = null;
        }
        else
        {
            consigneError = err;
        }
        return Task.CompletedTask;
    }

    /// <summary>
    /// Formate toujours à deux décimales, pas de zéro-padding avant la virgule.
    /// </summary>
    private static bool TryParseTwoDecimals(string input, out string formatted, out string? error)
    {
        formatted = "";
        error = null;

        if (!double.TryParse(input, NumberStyles.Float, CultureInfo.InvariantCulture, out var value) &&
            !double.TryParse(input, NumberStyles.Float, CultureInfo.GetCultureInfo("fr-FR"), out value))
        {
            error = "Valeur invalide (ex: 23.50)";
            return false;
        }

        formatted = value.ToString("0.00", CultureInfo.InvariantCulture); // impose deux décimales
        return true;
    }
    public async ValueTask DisposeAsync()
    {
        try
        {
            if (_consigneSubscribed)
                await JS.InvokeVoidAsync("unsubscribeFromMqtt", "/Sup/ConsigneTemperture");

            await JS.InvokeVoidAsync("unsubscribeFromMqtt", "/automate/ReguleEtat");
            await JS.InvokeVoidAsync("unsubscribeFromMqtt", "/automate/EtatFour");
            await JS.InvokeVoidAsync("unsubscribeFromMqtt", "/automate/temperature");

        }
        catch { /* best effort */ }
        _selfRef?.Dispose();
    }
}
